# Sanity — copy to .env.local. The project ID and dataset are public; the token
# is not. Create one with:
#   npx sanity tokens create "web draft mode" --project-id 47s55g10 --role viewer
NEXT_PUBLIC_SANITY_PROJECT_ID=47s55g10
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token — required for Draft Mode and the Presentation tool
SANITY_API_READ_TOKEN=
